DATABASE_URL=postgres://taste:taste@localhost:5432/taste
REDIS_URL=redis://localhost:6379

# Local Llama via Ollama — the only model path. Start it with `ollama serve`
# and pull the model:
#   ollama pull llama3.1:8b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Local model is the bottleneck; how many titles to enrich in parallel.
ENRICH_CONCURRENCY=3

PORT=3000
LOG_LEVEL=info

# Vocabulary version served by the API. Never mix versions in one query.
# v3 is AI-built by `npm run setup`, expanding the hand-seeded BASE below.
ACTIVE_VOCABULARY_VERSION=3
BASE_VOCABULARY_VERSION=2

# AniList rate limit. VERIFY THE CURRENT DOCUMENTED VALUE before changing.
# This is a global budget shared by every worker, not a per-process one.
ANILIST_RATE_PER_MIN=30
