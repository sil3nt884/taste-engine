# Local auth-proxy in front of a home-hosted Ollama, fronted by an OUTBOUND tunnel
# (ngrok or cloudflared). The tunnel provides the public HTTPS URL and reaches
# Caddy over localhost — so there is NO inbound port-forwarding, no TLS/ACME here,
# and it works behind CGNAT and inside WSL2 (all of which block inbound hosting).
#
# Chain:  Fly API  ->  https tunnel URL  ->  Caddy :8081 (checks bearer)  ->  Ollama :11434
#
# The token is read from the OLLAMA_TOKEN environment variable and must match the
# OLLAMA_TOKEN secret on taste-api. Set it in Caddy's systemd unit:
#   sudo systemctl edit caddy   ->   [Service]\nEnvironment=OLLAMA_TOKEN=your-token

:8081 {
	# Reject anything without the exact bearer token.
	@unauthorized not header Authorization "Bearer {env.OLLAMA_TOKEN}"
	respond @unauthorized "unauthorized" 401

	reverse_proxy 127.0.0.1:11434 {
		# Embedding/generation can be slow on CPU — don't cut long responses off.
		transport http {
			read_timeout 300s
		}
	}
}
