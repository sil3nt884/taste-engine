# Fastify API. Runs via tsx (the repo's tsc build is intentionally not used).
# Build context is the repo ROOT: `fly deploy -c fly/api.toml`.
FROM node:22-slim AS base
WORKDIR /app
ENV NODE_ENV=production

# tsx is a devDependency and is the runtime, so install the full tree.
COPY package.json package-lock.json ./
RUN npm ci --include=dev && npm cache clean --force

COPY tsconfig.json ./
COPY src ./src
COPY setup ./setup
COPY scripts ./scripts
COPY migrations ./migrations

EXPOSE 8080
CMD ["npx", "tsx", "src/server.ts"]
