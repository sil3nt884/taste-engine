{
  "name": "taste-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "setup": "tsx setup/setup.ts",
    "status": "node scripts/status.mjs",
    "ingest:catalogue": "tsx setup/ingest.ts",
    "franchise:resolve": "tsx setup/franchise.ts",
    "enrich:sample": "tsx setup/buildVocabulary.ts",
    "vocab:build": "tsx setup/buildVocabulary.ts",
    "vocab:suggestions": "tsx setup/suggestions.ts",
    "vocab:promote": "tsx setup/promote.ts",
    "enrich:catalogue": "tsx setup/enrich.ts",
    "embed:catalogue": "tsx setup/embed.ts",
    "moods:embed": "tsx setup/embedMoods.ts",
    "covers:backfill": "tsx setup/backfillCovers.ts",
    "cache:clusters": "tsx scripts/oneoff/clusterCache.ts",
    "search:reindex": "tsx setup/reindex.ts",
    "search:sync": "tsx setup/catalogSync.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "jose": "^5.10.0",
    "kafkajs": "^2.2.4",
    "meilisearch": "^0.45.0",
    "pg": "^8.22.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  }
}
